# Zugang zur Oberfläche
AUTH_USER=admin
AUTH_PASS=bitte-aendern
# Schlüssel für Chrome-Plugin, LabGate-App und pyLoad (langer Zufallstext)
API_KEY=
# Adresse, unter der du MediaButler erreichst (für Links in Telegram)
PUBLIC_URL=
# Ordner auf dem Host
DOWNLOADS_DIR=./incoming
MEDIA_DIR=./media
# Web-Port und Zeitzone
PORT=8080
TZ=Europe/Berlin
